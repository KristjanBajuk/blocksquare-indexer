# Network configuration for Envio indexer
# Options: mainnet, testnet
# Default: mainnet (production deployment)
ENVIO_NETWORK=mainnet

# Optional: Envio API key for deployment
# Get your API key from https://envio.dev
# ENVIO_API_KEY=your_api_key_here

# Optional: Custom RPC endpoints (if not using default Envio endpoints)
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key

# Optional: Database configuration (for local development)
# DATABASE_URL=postgres://user:password@localhost:5432/bstscan

# Optional: GraphQL endpoint configuration
# GRAPHQL_PORT=8080
# GRAPHQL_HOST=0.0.0.0